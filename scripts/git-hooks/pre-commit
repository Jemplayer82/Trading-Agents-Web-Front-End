#!/usr/bin/env bash
# scripts/git-hooks/pre-commit
#
# Blocks commits made directly on a tier branch. tier-1-base,
# tier-2-brokerage, and tier-3-scanner are generated artifacts produced by
# scripts/make_tier.py and force-pushed by .github/workflows/tiers.yml on
# every regeneration — any commit made directly on one of these branches is
# silently destroyed the next time the workflow runs. Develop on master
# instead. (The legacy tier/* pattern is still matched so a stale local
# checkout from before the rename is still protected.)
#
# This hook is NOT active by default (git only runs hooks from .git/hooks
# unless told otherwise). Activate it for your local checkout with:
#   git config core.hooksPath scripts/git-hooks
set -euo pipefail

branch="$(git symbolic-ref --short -q HEAD || true)"

case "$branch" in
  tier-*|tier/*)
    echo "ERROR: tier-* branches are generated artifacts — regenerated by tiers.yml, commits here are destroyed on next regen. Develop on master instead." >&2
    exit 1
    ;;
esac

exit 0
